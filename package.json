{
  "name": "dsh-git-panel",
  "version": "0.3.0",
  "description": "DSH Git 面板插件：在界面右下角提供一个纯点击的 Git 图形面板（状态/暂存/提交/分支管理/改动 diff/最近提交/拉取/推送/初始化/克隆），并在「设置 → 通用」里提供一个开关控制面板是否显示。宿主半边用 Node 内置 child_process 以参数数组方式执行 git（无 shell 注入面），客户端半边走同源 HTTP /git-panel/* 与宿主通信。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "panel",
    "cordis"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test"
  },
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
